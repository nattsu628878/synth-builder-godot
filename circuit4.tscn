[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Spike #4: add parts from the palette, drag them, wire terminal to terminal (blue). Click a wire to delete it. Click a part to select; Delete removes it. The wiring is compiled to a netlist and solved (MnaSolverRs) every sample. Green = source sawtooth, blue = output probe."
autowrap_mode = 2

